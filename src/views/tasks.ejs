<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tasks</title>
    <link href="/css/output.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/images/yin-yang-violet.png" />
  </head>
  <body
    data-theme="<%= locals.theme || 'stone' %>"
    data-dark="<%= locals.darkMode ? 'true' : 'false' %>"
    class="<%= locals.theme ? `theme-${locals.theme}` : 'theme-stone' %> <%= locals.darkMode ? 'dark' : '' %>"
  >
    <%- include('partials/navbar') %>

    <div class="container mx-auto px-6 py-8 max-w-5xl">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-800">Tasks</h1>
          <p class="text-gray-500 mt-1 text-sm">
            Toate task-urile tale într-un loc
          </p>
        </div>
        <button
          onclick="openAddTask()"
          class="px-4 py-2 bg-teal-400 text-white hover:bg-teal-500 text-sm font-medium rounded-xl transition-all shadow-sm"
        >
          + Task nou
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (tasks.length === 0) { %>
        <div
          class="bg-white rounded-2xl border border-gray-200 shadow-sm p-16 text-center col-span-full"
        >
          <p class="text-4xl mb-4">📋</p>
          <p class="text-gray-500 text-sm">Nu ai niciun task. Creează unul!</p>
        </div>
        <% } else { %>
        <% tasks.forEach(task => { %>
        <div
          class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5 flex flex-col justify-between h-full transition-all <%= task.completed ? 'opacity-60 bg-gray-50' : '' %>"
        >
          <div>
            <div class="flex flex-col gap-2 mb-4">
              <div class="flex items-start justify-between gap-4">
                <h2
                  class="text-lg font-bold text-gray-900 leading-tight <%= task.completed ? 'text-gray-400' : '' %>"
                >
                  <%= task.title %>
                </h2>
                <span
                  class="text-gray-400 text-xs font-medium whitespace-nowrap mt-1"
                >
                  <%= new Date(task.deadline).toLocaleDateString('ro-RO') %>
                </span>
              </div>

              <div class="flex">
                <span
                  class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border transition-all <%= task.completed ? 'bg-emerald-50 text-emerald-600 border-emerald-100' : 'bg-amber-50 text-amber-600 border-amber-100' %>"
                >
                  <%= task.completed ? '● Finalizat' : '○ În curs' %>
                </span>
              </div>
            </div>

            <p class="text-gray-600 text-sm leading-relaxed line-clamp-3">
              <%= task.description %>
            </p>
          </div>

          <div class="grid grid-cols-3 gap-3 mt-6">
            <button
              onclick="toggleComplete('<%= task._id %>')"
              title="<%= task.completed ? 'Anulează' : 'Finalizează' %>"
              class="group flex items-center justify-center duration-400 h-10 w-full rounded-xl border transition-all active:scale-95 shadow-sm <%= task.completed ? 'bg-emerald-500 text-white border-emerald-600 hover:bg-red-500 hover:border-red-600' : 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-500 hover:text-white' %>"
            >
              <% if (task.completed) { %>
              <svg
                xmlns="http://w3.org"
                class="h-5 w-5 block group-hover:hidden"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              <svg
                xmlns="http://w3.org"
                class="h-5 w-5 hidden group-hover:block"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>

              <% } else { %>
              <svg
                xmlns="http://w3.org"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              <% } %>
            </button>
            <button
              data-task-id="<%= task._id %>"
              data-task-title="<%= task.title %>"
              data-task-deadline="<%= task.deadline %>"
              data-task-desc="<%= task.description %>"
              data-completed="<%= task.completed %>"
              title="<%= task.completed ? 'Nu poți edita un task finalizat' : 'Editează' %>"
              class="edit-btn flex items-center justify-center h-10 w-full rounded-xl border transition-all shadow-sm <%= task.completed ? 'bg-gray-100 text-gray-400 border-gray-200 cursor-not-allowed opacity-50' : 'border-blue-200 bg-blue-50 text-blue-700 hover:bg-blue-500 hover:text-white active:scale-95' %>"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                />
              </svg>
            </button>

            <button
              onclick="deleteTask('<%= task._id %>', '<%= task.title %>')"
              title="Șterge"
              class="flex items-center duration-400 justify-center h-10 w-full rounded-xl border border-red-200 bg-red-50 hover:bg-red-500 hover:text-white text-red-700 transition-all active:scale-95 shadow-sm"
            >
              <svg
                xmlns="http://w3.org"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                />
              </svg>
            </button>
          </div>
        </div>
        <% }) %>
        <% } %>
      </div>
    </div>

    <div
      id="taskModal"
      class="hidden fixed inset-0 bg-black bg-opacity-30 flex items-center justify-center z-50"
    >
      <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md mx-4">
        <h2 id="modalTitle" class="text-lg font-bold text-gray-800 mb-4">
          Adaugă Task Nou
        </h2>
        <form id="taskForm" action="/tasks" method="POST">
          <div class="space-y-4">
            <div>
              <label
                class="block text-xs font-semibold text-gray-400 uppercase mb-1"
                >Titlu</label
              >
              <input
                id="modalTitleInput"
                type="text"
                name="title"
                required
                placeholder="Ce ai de făcut?"
                class="w-full px-4 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 transition-all"
              />
            </div>
            <div>
              <label
                class="block text-xs font-semibold text-gray-400 uppercase mb-1"
                >Dealine</label
              >
              <input
                id="modalDeadlineInput"
                type="date"
                name="deadline"
                class="w-full px-4 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 transition-all"
              />
            </div>
            <div>
              <label
                class="block text-xs font-semibold text-gray-400 uppercase mb-1"
                >Descriere</label
              >
              <textarea
                id="modalDescInput"
                name="description"
                rows="3"
                placeholder="Adaugă detalii..."
                class="w-full px-4 py-2 border border-gray-200 resize-none rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 transition-all"
              ></textarea>
            </div>
          </div>
          <div class="flex gap-2 mt-6">
            <button
              type="button"
              onclick="closeAddTask()"
              class="flex-1 px-4 py-2 border border-gray-200 rounded-xl text-sm text-gray-600 hover:bg-stone-50 transition-all"
            >
              Anulează
            </button>
            <button
              type="submit"
              class="flex-1 px-4 py-2 bg-teal-400 hover:bg-teal-500 text-white text-sm font-medium rounded-xl transition-all shadow-sm"
            >
              Salvează Task
            </button>
          </div>
        </form>
      </div>
    </div>

    <div
      id="deleteModal"
      class="hidden fixed inset-0 bg-black bg-opacity-30 flex items-center justify-center z-50"
    >
      <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md mx-4">
        <h2
          id="deleteTaskTitle"
          class="text-lg font-bold text-gray-800 mb-4"
        ></h2>
        <div class="flex gap-2 mt-6">
          <button
            id="cancelDelete"
            type="button"
            class="flex-1 px-4 py-2 border border-gray-200 rounded-xl text-sm text-gray-600 hover:bg-stone-50 transition-all"
          >
            Anulează
          </button>
          <button
            id="confirmDelete"
            type="submit"
            class="flex-1 px-4 py-2 bg-teal-400 hover:bg-teal-500 text-white text-sm font-medium rounded-xl transition-all shadow-sm"
          >
            Șterge Task-ul
          </button>
        </div>
      </div>
    </div>

    <script type="module" src="/js/main.js"></script>
  </body>
</html>
