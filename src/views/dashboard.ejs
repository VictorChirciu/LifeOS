<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link href="/css/output.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/images/yin-yang-gold-border.png" />
    <script type="module" src="/js/main.js"></script>
  </head>
  <body
    data-theme="<%= locals.theme || 'stone' %>"
    data-dark="<%= locals.darkMode ? 'true' : 'false' %>"
    class="<%= locals.theme ? `theme-${locals.theme}` : 'theme-stone' %> <%= locals.darkMode ? 'dark' : '' %>"
  >
    <%- include('partials/navbar') %>

    <div class="container mx-auto px-6 py-8">
      <h1 class="text-center text-4xl font-bold text-gray-800 mb-8">
        Bună, <%= username %> 👋
      </h1>

      <div class="grid grid-cols-4 gap-6 max-w-8xl mx-auto items-stretch">
        <div class="flex flex-col gap-4 justify-between">
          <div
            class="p-6 bg-white rounded-3xl shadow-sm border border-gray-200 text-center"
          >
            <h1
              id="clock"
              class="text-5xl font-['Bree+Serif'] font-black text-gray-900 tracking-tighter"
            >
              00:00:00
            </h1>
          </div>

          <div
            class="p-4 bg-white rounded-2xl shadow-sm border border-gray-200 text-center"
          >
            <h3
              id="date"
              class="text-2xl font-['Bree+Serif'] font-black text-gray-900 tracking-tighter"
            >
              00/00/0000
            </h3>
          </div>

          <div
            class="p-4 bg-white rounded-2xl shadow-sm border border-gray-200"
          >
            <% if (nextEvent) { %>
            <p
              class="text-xs text-gray-400 uppercase tracking-widest mb-3 text-center"
            >
              Următorul eveniment
            </p>
            <div class="text-center">
              <div class="flex items-center justify-center gap-2 mb-1">
                <span
                  class="w-2 h-2 rounded-full shrink-0"
                  style="background-color: <%= nextEvent.culoarea %>"
                ></span>
                <span class="text-sm font-semibold text-gray-800 truncate"
                  ><%= nextEvent.title %></span
                >
                <p class="text-xs text-gray-400">la <%= nextEvent.time %></p>
              </div>

              <div class="mt-4">
                <div
                  class="w-full bg-gray-200 rounded-full h-2.5 overflow-hidden"
                >
                  <div
                    id="progress-bar"
                    class="h-full transition-all duration-1000 ease-linear"
                    style="width: 0%; transition: width 0.5s ease-in-out"
                  ></div>
                </div>

                <p
                  id="countdown"
                  class="text-lg font-black font-['Bree+Serif'] text-gray-900 mt-2"
                >
                  00h 00m 00s
                </p>
              </div>
            </div>
            <% } else { %>
            <p
              class="text-xs text-gray-400 uppercase tracking-widest mb-3 text-center"
            >
              Progresul zilei
            </p>
            <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
              <div
                id="dayProgress"
                class="h-2 rounded-full transition-all"
                style="width: 0%; transition: width 0.5s ease-in-out"
              ></div>
            </div>
            <p
              id="dayProgressText"
              class="text-xs text-gray-400 text-center"
            ></p>
            <% } %>
          </div>

          <% if (nextEvent) { %>
          <script>
            window.__nextEventTime = "<%= nextEvent.time %>";
          </script>
          <% } %>

          <div
            class="p-4 bg-white rounded-2xl shadow-sm border border-gray-200 text-center"
          >
            <p class="text-xs text-gray-400 uppercase tracking-widest mb-2">
              Cuvântul zilei
            </p>
            <h3
              class="text-2xl font-black font-['Bree+Serif'] text-gray-900 tracking-tight"
            >
              <%= word.charAt(0).toUpperCase() + word.slice(1) %>
            </h3>
          </div>
        </div>

        <div
          class="col-span-2 bg-white rounded-2xl shadow-sm border border-gray-200 p-6"
        >
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
              <span class="text-2xl">📅</span> Evenimente de
              <%= day %>
              <%= month %>
              în istorie
            </h2>
            <span
              class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800"
            >
              Top
              <%= events.length %>
            </span>
          </div>
          <ul class="space-y-3">
            <% if (events && events.length > 0) { %> <% events.forEach(event =>
            { %>
            <li
              class="flex gap-6 p-4 rounded-xl hover:bg-gray-50 transition-colors border-b border-gray-100 last:border-0"
            >
              <span
                class="font-bold text-blue-600 min-w-[60px] shrink-0 text-base"
                ><%= event.year %></span
              >
              <p class="text-base text-gray-600 leading-relaxed">
                <%= event.text %>
              </p>
            </li>
            <% }) %>
            <% } else { %>
            <li class="flex flex-col items-center py-8 text-center">
              <span class="text-3xl mb-2">🔍</span>
              <p class="text-sm text-gray-400">
                Momentan nu am găsit evenimente istorice pentru azi.
              </p>
            </li>
            <% } %>
          </ul>
        </div>

        <!-- Dreapta: vreme, adaugă rapid -->
        <div class="flex flex-col gap-4 justify-between">
          <div
            class="p-4 bg-white rounded-2xl shadow-sm border border-gray-200"
          >
            <p
              class="text-xs text-gray-400 uppercase tracking-widest mb-2 text-center"
            >
              Vremea în Chișinău
            </p>
            <% if (weather) { %>
            <h3
              class="text-3xl font-black font-['Bree+Serif'] text-gray-900 tracking-tight text-center mb-3"
            >
              <%= weather.temp %>°C
            </h3>
            <div class="flex justify-around items-center">
              <div class="text-center">
                <p class="text-lg">🌡</p>
                <p class="text-xs text-gray-500"><%= weather.feels %>°C</p>
              </div>
              <div class="text-center">
                <p class="text-lg">💧</p>
                <p class="text-xs text-gray-500"><%= weather.humidity %>%</p>
              </div>
              <div class="text-center">
                <p class="text-lg">💨</p>
                <p class="text-xs text-gray-500"><%= weather.wind %> km/h</p>
              </div>
              <div class="text-center">
                <p class="text-lg">☁️</p>
                <p class="text-xs text-gray-500"><%= weather.cloudcover %>%</p>
              </div>
              <div class="text-center">
                <p class="text-lg">🌧</p>
                <p class="text-xs text-gray-500">
                  <%= weather.precipitation %> mm
                </p>
              </div>
            </div>
            <% } else { %>
            <p class="text-sm text-gray-400 text-center">Indisponibil</p>
            <% } %>
          </div>

          <div
            class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5 flex-1"
          >
            <h2 class="text-base font-bold text-gray-800 mb-6">
              ➕ Adaugă rapid
            </h2>
            <div class="flex flex-col gap-4">
              <a
                href="/tasks"
                class="flex items-center gap-3 p-3 rounded-xl hover:bg-stone-50 border border-gray-100 transition-all"
              >
                <span class="text-xl">✅</span>
                <span class="text-sm font-medium text-gray-700">Task nou</span>
              </a>
              <a
                href="/notes"
                class="flex items-center gap-3 p-3 rounded-xl hover:bg-stone-50 border border-gray-100 transition-all"
              >
                <span class="text-xl">📝</span>
                <span class="text-sm font-medium text-gray-700">Notă nouă</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
