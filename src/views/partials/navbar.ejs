<nav
  class="bg-white border-b border-gray-100 shadow-sm px-6 py-3 flex items-center justify-between"
>
  <a
    href="/dashboard"
    class="flex items-center gap-2 text-gray-800 font-bold text-lg tracking-tight"
  >
    <img src="/images/yin-yang.png" alt="LifeOS" id="logo" class="w-7 h-7" />
    LifeOS
  </a>

  <div class="flex items-center gap-1">
    <a
      href="/dashboard"
      class="px-4 py-2 rounded-lg font-medium text-base transition-all <%= activePage === 'dashboard' ? 'bg-stone-100 text-gray-900' : 'text-gray-600 hover:bg-stone-100 hover:text-gray-900' %>"
      >Dashboard</a
    >
    <a
      href="/notes"
      class="px-4 py-2 rounded-lg font-medium text-base transition-all <%= activePage === 'notes' ? 'bg-stone-100 text-gray-900' : 'text-gray-600 hover:bg-stone-100 hover:text-gray-900' %>"
      >Notes</a
    >
    <a
      href="/tasks"
      class="px-4 py-2 rounded-lg font-medium text-base transition-all <%= activePage === 'tasks' ? 'bg-stone-100 text-gray-900' : 'text-gray-600 hover:bg-stone-100 hover:text-gray-900' %>"
      >Tasks</a
    >
    <a
      href="/calendar"
      class="px-4 py-2 rounded-lg font-medium text-base transition-all <%= activePage === 'calendar' ? 'bg-stone-100 text-gray-900' : 'text-gray-600 hover:bg-stone-100 hover:text-gray-900' %>"
      >Calendar</a
    >
  </div>

  <div class="relative">
    <button
      id="userMenuBtn"
      class="flex items-center gap-2 bg-stone-100 px-3 py-2 rounded-xl hover:bg-stone-200 transition-all"
    >
      <% if (locals.avatar) { %>
      <img
        src="<%= locals.avatar %>"
        class="w-7 h-7 rounded-full object-cover"
        alt="avatar"
      />
      <% } else { %>
      <div
        class="w-7 h-7 rounded-full bg-blue-600 flex items-center justify-center text-white text-xs font-bold"
      >
        <%= locals.username ? locals.username.charAt(0).toUpperCase() : '' %>
      </div>
      <% } %>
      <span class="text-sm text-gray-700 font-medium"
        ><%= locals.username %></span
      >
      <svg
        class="w-4 h-4 text-gray-400"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m19 9-7 7-7-7"
        />
      </svg>
    </button>

    <div
      id="userMenu"
      class="hidden absolute right-0 mt-2 w-44 bg-white border border-gray-100 rounded-xl shadow-lg z-10"
    >
      <ul class="p-2 text-sm text-gray-600 font-medium">
        <li>
          <a
            href="/dashboard"
            class="flex items-center w-full px-3 py-2 hover:bg-stone-100 hover:text-gray-900 rounded-lg transition-all"
            >Dashboard</a
          >
        </li>
        <li>
          <button
            onclick="
              document
                .getElementById('settingsModal')
                .classList.remove('hidden')
            "
            class="flex items-center w-full px-3 py-2 hover:bg-stone-100 hover:text-gray-900 rounded-lg transition-all"
          >
            Settings
          </button>
        </li>
        <li>
          <a
            href="/logout"
            class="flex items-center w-full px-3 py-2 hover:bg-red-50 hover:text-red-500 rounded-lg transition-all"
            >Sign out</a
          >
        </li>
      </ul>
    </div>

    <div
      id="settingsModal"
      class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-[60] flex items-center justify-center"
    >
      <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md mx-4">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold text-gray-800">Setări Profil</h2>
          <button
            onclick="
              document.getElementById('settingsModal').classList.add('hidden')
            "
            class="text-gray-400 hover:text-gray-600 transition-colors"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>

        <form id="settingsForm" class="flex flex-col gap-4">
          <input
            type="hidden"
            id="avatarInput"
            name="avatar"
            value="<%= locals.avatar || '' %>"
          />

          <div class="flex items-center gap-4">
            <div>
              <label
                class="block text-xs font-semibold text-gray-500 uppercase mb-1"
                >Fotografie</label
              >
              <div
                class="group relative w-16 h-16 rounded-full cursor-pointer overflow-hidden"
                onclick="document.getElementById('fileInput').click()"
              >
                <div
                  class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 z-10 transition-all"
                ></div>
                <div
                  class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 z-20 bg-[url('/images/camera.png')] bg-contain bg-no-repeat bg-center w-8 h-8 transition-all"
                ></div>
                <div id="avatarPreview" class="w-full h-full">
                  <% if (locals.avatar) { %>
                  <img
                    src="<%= locals.avatar %>"
                    class="w-full h-full object-cover"
                    alt="avatar"
                  />
                  <% } else { %>
                  <div
                    class="w-full h-full bg-blue-600 flex items-center justify-center text-white text-xl font-bold"
                  >
                    <%= locals.username ?
                    locals.username.charAt(0).toUpperCase() : '' %>
                  </div>
                  <% } %>
                </div>
              </div>
              <input
                type="file"
                id="fileInput"
                accept="image/*"
                class="hidden"
              />
            </div>

            <div class="flex-1">
              <label
                class="block text-xs font-semibold text-gray-500 uppercase mb-1"
                >Username</label
              >
              <div class="flex items-stretch">
                <input
                  type="text"
                  name="username"
                  value="<%= locals.username %>"
                  disabled
                  class="w-full px-4 py-3 border border-gray-200 rounded-l-xl bg-gray-100 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 transition-all"
                />
                <button
                  type="button"
                  data-edit-toggle
                  class="px-4 bg-gray-800 hover:bg-gray-900 text-white text-xs font-bold rounded-r-xl transition-all"
                >
                  Editează
                </button>
              </div>
            </div>
          </div>

          <div>
            <label
              class="block text-xs font-semibold text-gray-500 uppercase mb-1"
              >Email</label
            >
            <div class="flex items-stretch">
              <input
                type="email"
                name="email"
                value="<%= locals.email || '' %>"
                disabled
                class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-100 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 transition-all"
              />
            </div>
          </div>

          <div>
            <label
              class="block text-xs font-semibold text-gray-500 uppercase mb-1"
              >Parolă nouă</label
            >
            <div class="flex items-stretch">
              <div class="relative flex-grow">
                <input
                  type="password"
                  name="password"
                  placeholder="Lasă gol pentru a nu schimba"
                  disabled
                  class="w-full px-4 py-3 border border-gray-200 rounded-l-xl bg-gray-100 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 transition-all"
                />
              </div>
              <button
                type="button"
                data-password-toggle
                class="px-4 bg-gray-800 hover:bg-gray-900 text-white text-xs font-bold rounded-r-xl transition-all"
              >
                Editează
              </button>
            </div>
          </div>

          <div>
            <label
              class="block text-xs font-semibold text-gray-500 uppercase mb-2"
              >Temă</label
            >
            <div class="flex justify-between gap-1">
              <button
                type="button"
                title="stone"
                data-theme="stone"
                onclick="applyTheme('stone')"
                class="w-16 h-12 p-1.5 bg-white border border-stone-200 rounded-xl transition-all shadow-sm hover:ring-2 hover:ring-offset-1 hover:ring-stone-200"
              >
                <div
                  class="flex items-center justify-center w-full h-full rounded-lg bg-[#f5f5f4] border border-stone-200"
                >
                  <img
                    src="/images/check-mark.png"
                    alt="Check"
                    class="hidden w-5 h-5 object-contain opacity-80"
                  />
                </div>
              </button>

              <button
                type="button"
                title="snow"
                data-theme="snow"
                onclick="applyTheme('snow')"
                class="w-16 h-12 p-1.5 bg-white border border-gray-300 rounded-xl transition-all shadow-sm hover:ring-2 hover:ring-offset-1 hover:ring-gray-200"
              >
                <div
                  class="flex items-center justify-center w-full h-full rounded-lg bg-slate-50 border border-slate-200"
                >
                  <img
                    src="/images/check-mark.png"
                    alt="Check"
                    class="hidden w-5 h-5 object-contain opacity-80"
                  />
                </div>
              </button>
              <button
                type="button"
                title="zinc"
                data-theme="zinc"
                onclick="applyTheme('zinc')"
                class="w-16 h-12 p-1.5 bg-white border border-gray-300 rounded-xl transition-all shadow-sm hover:ring-2 hover:ring-offset-1 hover:ring-zinc-200"
              >
                <div
                  class="flex items-center justify-center w-full h-full rounded-lg bg-gray-200 border border-gray-300"
                >
                  <img
                    src="/images/check-mark.png"
                    alt="Check"
                    class="hidden w-5 h-5 object-contain opacity-80"
                  />
                </div>
              </button>
              <button
                type="button"
                title="sand"
                data-theme="sand"
                onclick="applyTheme('sand')"
                class="w-16 h-12 p-1.5 bg-white border border-gray-300 rounded-xl transition-all shadow-sm hover:ring-2 hover:ring-offset-1 hover:ring-orange-100"
              >
                <div
                  class="flex items-center justify-center w-full h-full rounded-lg bg-[#f5f0e8] border border-stone-200"
                >
                  <img
                    src="/images/check-mark.png"
                    alt="Check"
                    class="hidden w-5 h-5 object-contain opacity-80"
                  />
                </div>
              </button>
              <button
                type="button"
                title="mint"
                data-theme="mint"
                onclick="applyTheme('mint')"
                class="w-16 h-12 p-1.5 bg-white border border-gray-300 rounded-xl transition-all shadow-sm hover:ring-2 hover:ring-offset-1 hover:ring-emerald-200"
              >
                <div
                  class="flex items-center justify-center w-full h-full rounded-lg bg-emerald-50 border border-emerald-100"
                >
                  <img
                    src="/images/check-mark.png"
                    alt="Check"
                    class="hidden w-5 h-5 object-contain opacity-80"
                  />
                </div>
              </button>
            </div>
          </div>

          <div
            class="flex flex-col gap-2 bg-gray-50 p-3 rounded-xl border border-gray-100"
          >
            <label class="flex items-center justify-between cursor-pointer">
              <span class="text-sm font-medium text-gray-700">Fundal plat</span>
              <input type="checkbox" name="bgToggle" class="w-4 h-4 rounded" />
            </label>
            <div class="h-px bg-gray-200"></div>
            <label
              class="flex items-center justify-between cursor-not-allowed opacity-60"
            >
              <span class="text-sm text-gray-400 font-medium"
                >Notificări Email</span
              >
              <input
                type="checkbox"
                name="notifications"
                disabled
                class="w-4 h-4 rounded cursor-not-allowed"
              />
            </label>
            <div class="h-px bg-gray-200"></div>
            <label class="flex items-center justify-between cursor-pointer">
              <span class="text-sm font-medium text-gray-700">Mod Noapte</span>
              <input
                type="checkbox"
                name="darkMode"
                class="w-4 h-4 rounded accent-blue-600"
              />
            </label>
          </div>

          <div class="flex gap-3">
            <button
              type="button"
              id="cancelSettingsBtn"
              class="flex-1 px-4 py-2.5 border border-gray-200 rounded-xl text-sm font-medium text-gray-600 hover:bg-gray-50 transition-all"
            >
              Anulează
            </button>
            <button
              type="button"
              id="saveSettingsBtn"
              class="flex-1 px-4 py-2.5 bg-gray-800 hover:bg-gray-900 text-white text-sm font-bold rounded-xl transition-all"
            >
              Salvează
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</nav>
